{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TelegramBot": {
    "BaseUrl": "https://localhost:7175"
  },
  "Pagination": {
    "PageSize" : 1
  },
  "ClientType":
  {
    "Type": "Grpc"
  },
  "LinkProcessingOptions": {
    "BatchSize": 1,
    "MaxDegreeOfParallelism": 4,
    "NotificationBatchSize": 1,
    "ReportBatchSize": 1,
    "UpdateInterval": "00:01:00",
    "NotificationInterval": "00:00:10",
    "ReportInterval": "00:00:15"
  }
}
