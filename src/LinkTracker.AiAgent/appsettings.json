{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AiAgent": {
    "Filtering": {
      "StopWords": 
        ["spam",
        "ads",
        "promo"],
      "ExcludedAuthors": 
      ["bot-user"],
      "MinLength": 10
    },
    "Summarization": {
      "Threshold": 200,
      "Provider": "Stub",
      "Model": "facebook/bart-large-cnn"
    },
    "Prioritization" : {
      "HighKeywords" :
        [
          "critical", 
          "urgent",
          "breaking",
          "security"
        ],
      "LowKeywords":
        [
          "minor",
          "typo",
          "chore",
          "docs"
        ]
    },  
    "Grouping" : {
      "WindowMs": 300000
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerTopic": "link-updates",
    "ProduceTopic": "link-updates-processed",
    "GroupId": "link-tracker-ai-agent",
    "SchemaRegistryUrl": "http://localhost:8081"
  }
          
}
