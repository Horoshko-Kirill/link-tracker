{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TelegramBot": {
    "BaseUrl": "https://localhost:7175"
  },
  "Pagination": {
    "PageSize" : 3
  },
  "ClientType":
  {
    "Type": "Grpc"
  },
  "LinkProcessingOptions": {
    "BatchSize": 5,
    "MaxDegreeOfParallelism": 4,
    "NotificationBatchSize": 5,
    "ReportBatchSize": 5,
    "UpdateInterval": "00:01:00",
    "NotificationInterval": "00:00:10",
    "ReportInterval": "00:00:15",
    "OutboxMaxAttempts": 3,
    "OutboxInterval": "00:00:15"
  },
  "Notification":
  {
    "Transport": "Http"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "link-updates",
    "SchemaRegistryUrl": "http://localhost:8081"
  }
}
