{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Scrapper": {
    "BaseUrl": "https://localhost:7197"
  },
  "UseFakeTelegramClient": false,
  "ClientType":
  {
    "Type": "Grpc"
  },
  "Pagination": {
    "PageSize" : 3
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "link-updates-processed",
    "GroupId": "link-tracker-bot",
    "DeadLetterTopic": "link-updates-dlq",
    "MaxProcessingAttempts": 3,
    "RetryDelayMilliseconds": 1000,
    "SchemaRegistryUrl": "http://localhost:8081"
  },
  "Valkey": {
    "Configuration": "valkey-node-0:6379,valkey-node-1:6379,valkey-node-2:6379",
    "DefaultTtlMinutes": "24:00:00",
    "Enabled" : true
  },
  "Resilience": {
    "TimeoutSeconds": 5,
    "Retry": {
      "MaxAttempts": 3,
      "DelayMilliseconds": 1000,
      "RetryableStatusCodes": [429, 500, 502, 503, 504]
    },
    "CircuitBreaker": {
      "FailureThreshold": 0.5,
      "SamplingDurationSeconds": 10,
      "MinimumThroughput": 5,
      "DurationOfBreakSeconds": 30
    }
  }
}
