{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TelegramBot": {
    "BaseUrl": "https://localhost:7175"
  },
  "Pagination": {
    "PageSize" : 3
  },
  "ClientType":
  {
    "Type": "Grpc"
  },
  "LinkProcessingOptions": {
    "BatchSize": 5,
    "MaxDegreeOfParallelism": 4,
    "NotificationBatchSize": 5,
    "ReportBatchSize": 5,
    "UpdateInterval": "00:01:00",
    "NotificationInterval": "00:00:10",
    "ReportInterval": "00:00:15",
    "OutboxMaxAttempts": 3,
    "OutboxInterval": "00:00:15"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "link-updates",
    "SchemaRegistryUrl": "http://localhost:8081"
  },
  "Valkey": {
    "Configuration": "valkey-node-0:6379,valkey-node-1:6379,valkey-node-2:6379",
    "DefaultTtlMinutes": "00:10:00",
    "Enabled" : true
  },
  "Resilience": {
    "TimeoutSeconds": 5,
    "Retry": {
      "MaxAttempts": 3,
      "DelayMilliseconds": 1000,
      "RetryableStatusCodes": [429, 500, 502, 503, 504]
    },
    "CircuitBreaker": {
      "FailureThreshold": 0.5,
      "SamplingDurationSeconds": 10,
      "MinimumThroughput": 5,
      "DurationOfBreakSeconds": 30
    }
  }
}
